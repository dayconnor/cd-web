---
// The softened photograph behind a page (styles in site.css). `extras` are
// further photographs stacked above it, hidden until a page shows one (the
// homepage does on hover). Renders nothing if the photo file is missing.
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import { getPhoto } from "../lib/photos";

interface Extra { id: string; image: ImageMetadata; focus?: string }
interface Props { name: string; extras?: Extra[]; fixed?: boolean }
const { name, extras = [], fixed = false } = Astro.props;
const base = getPhoto(name);

// Softened, so it never needs more than about one image pixel per screen pixel.
const widths = [800, 1280, 1920];
const at = (focus?: string) => (focus ? `object-position: ${focus}` : undefined);
---
{base && (
  <div class:list={["backdrop", { "backdrop--fixed": fixed }]} aria-hidden="true">
    <div class="shot shot--base">
      <Picture src={base.image} formats={["avif"]} widths={widths} sizes="100vw" quality={55} alt="" loading="eager" fetchpriority="high" style={at(base.info?.focus)} />
    </div>
    {extras.map((s) => (
      <div class="shot" data-for={s.id}>
        <Picture src={s.image} formats={["avif"]} widths={widths} sizes="100vw" quality={55} alt="" loading="lazy" fetchpriority="low" style={at(s.focus)} />
      </div>
    ))}
  </div>
)}
