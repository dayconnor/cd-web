---
import { site } from "../site";
interface Props { current?: "home" | "projects" | "contact"; overlay?: boolean }
const { current, overlay = false } = Astro.props;
---
<header class:list={["site-header", overlay ? "site-header--overlay wide" : "wrap"]}>
  <a href="/" class="site-title" aria-current={current === "home" ? "page" : undefined}>
    <span class="lamp-dot" aria-hidden="true"></span>
    {site.name}
  </a>
  <nav class="site-nav" aria-label="Primary">
    <a href="/#projects" aria-current={current === "projects" ? "page" : undefined}>projects</a>
    <a href={site.cv} class="ext" target="_blank" rel="noopener">cv</a>
    <a href="/contact" aria-current={current === "contact" ? "page" : undefined}>contact</a>
    <a href={site.github} class="ext" target="_blank" rel="noopener">github</a>
  </nav>
</header>
